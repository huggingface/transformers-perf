-            self.compile_config = CompileConfig(**compile_kwargs)
+            # A guard filter is named in JSON scenarios, e.g. "skip_guard_on_inbuilt_nn_modules_unsafe"
+            options = dict(compile_kwargs.get("options") or {})
+            self.guard_filter = compile_kwargs.pop("guard_filter_fn", None) or options.pop("guard_filter_fn", None)
+            if options or "options" in compile_kwargs:
+                compile_kwargs["options"] = options or None
+            self.compile_mode = compile_kwargs.get("mode", "reduce-overhead")
+            self.compile_config = make_compile_config(compile_kwargs, self.guard_filter)
         self.kernelize = kernelize
