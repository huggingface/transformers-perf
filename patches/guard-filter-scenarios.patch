+def make_compile_config(compile_kwargs: dict[str, Any], guard_filter: str | None) -> CompileConfig:
+    """`CompileConfig(**compile_kwargs)`, with the guard filter `torch.compiler.<guard_filter>` if one is named.
+
+    `CompileConfig` takes `guard_filter_fn` since #50964. On an older transformers, the filter goes through
+    `torch.compile`'s `options` instead, which excludes `mode`: the mode is expanded into its inductor options. Both
+    sides of an A/B then run the same scenario."""
+    if guard_filter is None:
+        return CompileConfig(**compile_kwargs)
+    fn = getattr(torch.compiler, guard_filter)
+    if "guard_filter_fn" in getattr(CompileConfig, "__dataclass_fields__", {}):
+        return CompileConfig(**compile_kwargs, guard_filter_fn=fn)
+    from torch._inductor import list_mode_options
+
+    kwargs = dict(compile_kwargs)
+    mode = kwargs.pop("mode", "reduce-overhead")
+    options = {**list_mode_options(mode, kwargs.get("dynamic")), **(kwargs.pop("options", None) or {})}
+    return CompileConfig(**kwargs, mode=None, options={**options, "guard_filter_fn": fn})
+
+
 class BenchmarkConfig:
     """Configuration for a single benchmark scenario."""
 
